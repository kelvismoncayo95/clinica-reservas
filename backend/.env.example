# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/clinica_reservas

# Security
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Email (Resend)
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=re_your_api_key_here

# Business Rules
APPOINTMENT_MIN_HOURS_NOTICE=1
APPOINTMENT_MAX_DAYS_AHEAD=60
APPOINTMENT_MAX_FUTURE_PER_PATIENT=3
APPOINTMENT_MIN_HOURS_CANCEL_PATIENT=24
CLINIC_TIMEZONE=America/Montevideo

# "Olvidé mi contraseña": URL del frontend (para el link del correo)
# y minutos que dura el enlace
FRONTEND_URL=http://localhost:5500
PASSWORD_RESET_EXPIRE_MINUTES=30
