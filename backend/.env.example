# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de datos
DATABASE_URL=postgresql://usuario:password@host:5432/clinica_reservas

# Seguridad
SECRET_KEY=cambiar_por_una_clave_generada_localmente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Reglas de negocio de citas
APPOINTMENT_MIN_HOURS_NOTICE=1
APPOINTMENT_MAX_DAYS_AHEAD=60
APPOINTMENT_MAX_FUTURE_PER_PATIENT=3
APPOINTMENT_MIN_HOURS_CANCEL_PATIENT=24
